# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL="postgresql://user:pass@localhost:5432/tapcard"

# Signs web session cookies AND mobile bearer tokens. Generate with:
#   npx auth secret        (or)   openssl rand -base64 32
# Changing it invalidates every existing session and mobile token.
AUTH_SECRET=""

# Public origin, used to build every share link and QR payload via appUrl().
# NOTE: NEXT_PUBLIC_* is baked into the bundle at BUILD time, so changing this in
# production requires a rebuild — restarting the container won't pick it up. A
# production build refuses to run if this is unset or points at a local/private
# address (see src/lib/env-check.ts), because dead QR codes are worse than a
# failed deploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ── Sign-in: Google SSO ──────────────────────────────────────────────────────
# Tapcard has exactly two ways in: Google, and a one-time code emailed to the
# user. Google stays HIDDEN on /login until both values below are set.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorized redirect URIs:
#       http://localhost:3000/api/auth/callback/google      (dev)
#       https://<your-domain>/api/auth/callback/google      (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Native apps only. Google issues a SEPARATE client ID per platform, and the ID
# token's `aud` is whichever the app used — list them comma-separated here.
# /api/mobile/oauth/google returns 501 while this is unset: without an audience
# to check against, an ID token minted for any other Google app would be
# accepted, letting anyone sign in as any Google user.
GOOGLE_MOBILE_CLIENT_IDS=""


# ── Sign-in: one-time email codes ────────────────────────────────────────────
# SMTP connection string. Leave EMPTY in dev — codes are printed to the server
# console instead of being emailed (see src/lib/otp.ts).
#   smtp://user:pass@smtp.gmail.com:587      (Gmail app password)
#   smtp://resend:re_xxx@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="Tapcard <no-reply@tapcard.example.com>"


# ── Optional ─────────────────────────────────────────────────────────────────
# Shared secret for the legacy iOS onboard/delete-account paths. When set, those
# requests must send a matching `x-tapcard-key` header.
MOBILE_API_KEY=""

# Additional SSO providers — same conditional wiring as Google; each stays
# hidden until its ID and secret are both present.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Claude Agent SDK (bio generation, lead scoring). Subscription auth — run
# `claude setup-token` for headless/production.
CLAUDE_CODE_OAUTH_TOKEN=""
